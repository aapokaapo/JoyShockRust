# Allow the active local seat to use force feedback on supported physical Sony pads.
# Run before the distribution's seat-late rule applies the uaccess ACL.
SUBSYSTEM=="input", KERNEL=="event*", DEVPATH!="/devices/virtual/*", ATTRS{id/bustype}=="0003|0005", ATTRS{id/vendor}=="054c", ATTRS{id/product}=="0ce6|0df2", ATTRS{capabilities/ff}=="*[1-9a-fA-F]*", TAG+="uaccess"
